<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.oetd.sentencebuilder.SentenceBuilderController"
      stylesheets="@generated-sentences.css">
    <children>
        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="Tokens &amp; Generator">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                            </padding>
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="Algorithm:" />
                                <ComboBox fx:id="algorithmComboBox" />
                                <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"/>
                                <Button fx:id="generateButton" text="Generate" onAction="#handleGenerate"/>
                            </HBox>
                            <Label text="Select an algorithm and click Generate, or click a word in the table first to start with it. Double-click any row to view the words that follow it." />
                            <TextField fx:id="generatedTextField" promptText="Generated sentence..."/>
                            <TableView fx:id="tokenTableView" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="idColumn" text="id" prefWidth="50"/>
                                    <TableColumn fx:id="textColumn" text="text" prefWidth="150"/>
                                    <TableColumn fx:id="totalCountColumn" text="totalCount" prefWidth="90"/>
                                    <TableColumn fx:id="startCountColumn" text="startCount" prefWidth="90"/>
                                    <TableColumn fx:id="endCountColumn" text="endCount" prefWidth="90"/>
                                    <TableColumn fx:id="createdAtColumn" text="createdAt" prefWidth="165"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>
                <!-- James Parker - 11/25/2026: Batch Generator tab for generating random-start sentences and adding them to the corpus (AI-assisted via Gemini) -->
                <Tab text="Batch Generator">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                            </padding>
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="Algorithm:" />
                                <ComboBox fx:id="batchAlgorithmComboBox" />
                                <Label text="Count:" />
                                <TextField fx:id="batchCountField" text="10" prefWidth="60" />
                                <Button text="Generate Batch" onAction="#handleBatchGenerate" />
                                <Button fx:id="addBatchButton" text="Add to Database"
                                        onAction="#handleAddBatchToDatabase" disable="true" />
                            </HBox>
                            <Label text="Choose an algorithm and count, click Generate Batch, then click Add to Database." />
                            <TextArea fx:id="batchOutputArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
                        </VBox>
                    </content>
                </Tab>
                <!-- James Parker - 11/25/2026: Dedicated Auto-Complete tab separated from the main generator tab (AI-assisted via Gemini) -->
                <Tab text="Auto-Complete">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                            </padding>
                            <Label text="Type below. Suggestions update after a space, comma, or period." />
                            <TextArea fx:id="autoCompleteTextArea" wrapText="true"
                                      onKeyReleased="#handleAutoSuggest" />
                            <HBox fx:id="autoSuggestBox" spacing="10.0" alignment="CENTER_LEFT" />
                        </VBox>
                    </content>
                </Tab>
                <!--    // Aniq Sunesara 11/20/26 prompt: "Add a tab onto the GUI that will display all the generated sentences and related data" -->
                <Tab fx:id="generatedSentencesTab" text="Generated Sentences">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                            </padding>
                            <HBox spacing="12.0" alignment="CENTER_LEFT">
                                <Label text="Saved generated sentences" style="-fx-font-weight: bold;"/>
                                <Label fx:id="generatedSentenceCountLabel" text="0 saved sentences"/>
                                <Label fx:id="matchingSentenceHashLabel"
                                       text="Select a sentence to highlight matching hashes"/>
                                <Button text="Refresh" onAction="#handleRefreshGeneratedSentences"/>
                            </HBox>
                            <TableView fx:id="generatedSentencesTableView" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="sentenceIdColumn" text="ID" prefWidth="60"/>
                                    <TableColumn fx:id="sentenceTextColumn" text="Sentence" prefWidth="300"/>
                                    <TableColumn fx:id="generationMethodColumn" text="Method" prefWidth="145"/>
                                    <TableColumn fx:id="startingTokenIdColumn" text="Start token ID" prefWidth="105"/>
                                    <TableColumn fx:id="startingTokenTextColumn" text="Start word" prefWidth="110"/>
                                    <TableColumn fx:id="addedToCorpusColumn" text="In corpus?" prefWidth="90"/>
                                    <TableColumn fx:id="generatedAtColumn" text="Generated at" prefWidth="160"/>
                                    <TableColumn fx:id="sentenceHashColumn" text="SHA-256" prefWidth="210"/>
                                </columns>
                            </TableView>
                            <Label text="Selected sentence details (select any row):" />
                            <TextArea fx:id="generatedSentenceDetails" editable="false"
                                      wrapText="true" prefRowCount="6" />
                        </VBox>
                    </content>
                </Tab>
                <!-- James Parker - 11/25/2026: Imported Files history tab displaying past imports and file metadata (AI-assisted via Gemini) -->
                <Tab fx:id="importedFilesTab" text="Imported Files">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                            </padding>
                            <HBox spacing="12.0" alignment="CENTER_LEFT">
                                <Label text="Imported file history" style="-fx-font-weight: bold;"/>
                                <Label fx:id="importedFileCountLabel" text="0 imported files"/>
                                <Button fx:id="importButton" text="Select File to Import" onAction="#handleImport"/>
                                <Button text="Refresh" onAction="#handleRefreshImportedFiles"/>
                            </HBox>
                            <TableView fx:id="importedFilesTableView" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="fileIdColumn" text="ID" prefWidth="60"/>
                                    <TableColumn fx:id="fileNameColumn" text="File Name" prefWidth="260"/>
                                    <TableColumn fx:id="fileTokenCountColumn" text="Token Count" prefWidth="110"/>
                                    <TableColumn fx:id="fileImportedAtColumn" text="Imported At" prefWidth="170"/>
                                    <TableColumn fx:id="fileHashColumn" text="SHA-256" prefWidth="250"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>
