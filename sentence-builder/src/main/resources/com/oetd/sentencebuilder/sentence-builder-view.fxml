<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.oetd.sentencebuilder.SentenceBuilderController"
      stylesheets="@generated-sentences.css">
    <children>
        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="Tokens &amp; Generator">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                            </padding>
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="Algorithm:" />
                                <ComboBox fx:id="algorithmComboBox" />
                                <Button fx:id="importButton" text="Select File to Import" onAction="#handleImport"/>
                                <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"/>
                                <Button fx:id="generateButton" text="Generate" onAction="#handleGenerate"/>
                            </HBox>
                            <TextField fx:id="generatedTextField" promptText="Generated sentence..."
                                       onKeyTyped="#handleAutoSuggest"/>
                            <HBox fx:id="autoSuggestBox" spacing="10.0" alignment="CENTER_LEFT" />
                            <TableView fx:id="tokenTableView" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="idColumn" text="id" prefWidth="50"/>
                                    <TableColumn fx:id="textColumn" text="text" prefWidth="150"/>
                                    <TableColumn fx:id="totalCountColumn" text="totalCount" prefWidth="90"/>
                                    <TableColumn fx:id="startCountColumn" text="startCount" prefWidth="90"/>
                                    <TableColumn fx:id="endCountColumn" text="endCount" prefWidth="90"/>
                                    <TableColumn fx:id="createdAtColumn" text="createdAt" prefWidth="165"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>
                <Tab fx:id="generatedSentencesTab" text="Generated Sentences">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                            </padding>
                            <HBox spacing="12.0" alignment="CENTER_LEFT">
                                <Label text="Saved generated sentences" style="-fx-font-weight: bold;"/>
                                <Label fx:id="generatedSentenceCountLabel" text="0 saved sentences"/>
                                <Label fx:id="matchingSentenceHashLabel"
                                       text="Select a sentence to highlight matching hashes"/>
                                <Button text="Refresh" onAction="#handleRefreshGeneratedSentences"/>
                            </HBox>
                            <TableView fx:id="generatedSentencesTableView" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="sentenceIdColumn" text="ID" prefWidth="60"/>
                                    <TableColumn fx:id="sentenceTextColumn" text="Sentence" prefWidth="300"/>
                                    <TableColumn fx:id="generationMethodColumn" text="Method" prefWidth="145"/>
                                    <TableColumn fx:id="startingTokenIdColumn" text="Start token ID" prefWidth="105"/>
                                    <TableColumn fx:id="startingTokenTextColumn" text="Start word" prefWidth="110"/>
                                    <TableColumn fx:id="addedToCorpusColumn" text="In corpus?" prefWidth="90"/>
                                    <TableColumn fx:id="generatedAtColumn" text="Generated at" prefWidth="160"/>
                                    <TableColumn fx:id="sentenceHashColumn" text="SHA-256" prefWidth="210"/>
                                </columns>
                            </TableView>
                            <Label text="Selected sentence details (select any row):" />
                            <TextArea fx:id="generatedSentenceDetails" editable="false"
                                      wrapText="true" prefRowCount="6" />
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>
