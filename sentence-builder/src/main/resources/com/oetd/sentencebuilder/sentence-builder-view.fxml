<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.oetd.sentencebuilder.SentenceBuilderController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Algorithm:" />
        <ComboBox fx:id="algorithmComboBox" />
        <Button fx:id="importButton" text="Select File to Import" onAction="#handleImport"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"/>
        <Button fx:id="generateButton" text="Generate" onAction="#handleGenerate"/>
    </HBox>

    <TextField fx:id="generatedTextField" promptText="Generated sentence..."/>

    <TableView fx:id="tokenTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="id" prefWidth="50"/>
            <TableColumn fx:id="textColumn" text="text" prefWidth="150"/>
            <TableColumn fx:id="totalCountColumn" text="totalCount" prefWidth="80"/>
            <TableColumn fx:id="startCountColumn" text="startCount" prefWidth="80"/>
            <TableColumn fx:id="endCountColumn" text="endCount" prefWidth="80"/>
            <TableColumn fx:id="createdAtColumn" text="createdAt" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
